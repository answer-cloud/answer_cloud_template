---
import Icon from './Icon.astro';
import '../styles/step-previews.css';
---
<div class="project-setup" role="img" aria-label="Example project: Website refresh, with a project brief and design direction in draft.">
  <div class="project-setup-header"><span class="project-setup-icon"><Icon name="folder" size={16}/></span><span>New project</span><span class="project-setup-menu" aria-hidden="true">•••</span></div>
  <strong class="project-setup-title">Website refresh</strong>
  <div class="project-setup-items"><div><Icon name="file" size={13}/><span>Project brief</span><i>Draft</i></div><div><Icon name="grid" size={13}/><span>Design direction</span><span class="project-setup-count">3</span></div></div>
  <div class="project-setup-footer"><span class="project-setup-avatars" aria-hidden="true"><i>JL</i><i>AK</i><i>MS</i></span><span>3 teammates</span></div>
</div>
