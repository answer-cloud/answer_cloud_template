<gradient-backdrop data-gradient-state="paused">
  <div class="product-glow" aria-hidden="true"><div class="product-glow-blue"></div></div>
  <button class="gradient-toggle" type="button" aria-label="Pause background animation" title="Pause background animation" hidden>
    <svg data-pause-icon width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M7 5v10M13 5v10" /></svg>
    <svg data-play-icon width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true" hidden><path d="m7 4 9 6-9 6V4Z" /></svg>
  </button>
</gradient-backdrop>

<script>
  class GradientBackdropElement extends HTMLElement {
    private preference?: MediaQueryList;
    private observer?: IntersectionObserver;
    private button?: HTMLButtonElement;
    private inView = false;
    private userPaused = false;
    private pageHidden = false;

    private sync = () => {
      const reduced = Boolean(this.preference?.matches);
      const running = !reduced && !this.userPaused && this.inView && !document.hidden && !this.pageHidden;
      this.dataset.gradientState = reduced ? 'reduced' : running ? 'running' : 'paused';
      if (!this.button) return;
      this.button.hidden = reduced;
      const label = this.userPaused ? 'Resume background animation' : 'Pause background animation';
      this.button.setAttribute('aria-label', label);
      this.button.title = label;
      this.querySelector<SVGElement>('[data-pause-icon]')?.toggleAttribute('hidden', this.userPaused);
      this.querySelector<SVGElement>('[data-play-icon]')?.toggleAttribute('hidden', !this.userPaused);
    };

    private toggle = () => { this.userPaused = !this.userPaused; this.sync(); };
    private onPageHide = () => { this.pageHidden = true; this.sync(); };
    private onPageShow = () => { this.pageHidden = false; this.sync(); };

    connectedCallback() {
      this.pageHidden = false;
      this.button = this.querySelector<HTMLButtonElement>('button') ?? undefined;
      this.preference = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.preference.addEventListener('change', this.sync);
      this.button?.addEventListener('click', this.toggle);
      document.addEventListener('visibilitychange', this.sync);
      window.addEventListener('pagehide', this.onPageHide);
      window.addEventListener('pageshow', this.onPageShow);
      const stage = this.parentElement;
      if (stage) {
        this.observer = new IntersectionObserver(entries => {
          this.inView = entries[0].isIntersecting;
          this.sync();
        });
        this.observer.observe(stage);
      }
      this.sync();
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.preference?.removeEventListener('change', this.sync);
      this.button?.removeEventListener('click', this.toggle);
      document.removeEventListener('visibilitychange', this.sync);
      window.removeEventListener('pagehide', this.onPageHide);
      window.removeEventListener('pageshow', this.onPageShow);
      this.dataset.gradientState = 'paused';
    }
  }

  if (!customElements.get('gradient-backdrop')) customElements.define('gradient-backdrop', GradientBackdropElement);
</script>
