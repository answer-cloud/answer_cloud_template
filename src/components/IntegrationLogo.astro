---
interface Props {
  name: 'notion' | 'slack' | 'figma' | 'drive';
  size?: number;
}
const { name, size = 22 } = Astro.props;
const labels = { notion: 'Notion', slack: 'Slack', figma: 'Figma', drive: 'Google Drive' };
---
<span class={`integration-logo integration-logo-${name}`} role="img" aria-label={labels[name]} title={labels[name]}>
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    {name === 'notion' && <>
      <path d="m4.1 3.4 12.5-.8 3.4 2.3v15.5l-12.8 1-3.3-2.9V3.4Z" fill="white" stroke="#171717" stroke-width="1.25" stroke-linejoin="round" />
      <path d="m4.2 3.5 3.2 2.6 12.4-.9M7.4 6.2v15" stroke="#171717" stroke-width="1.1" stroke-linejoin="round" />
      <path d="m9 9 2.5-.2 4.7 7V9.7l-1.1-.1V8.3l3.1-.2v1.3l-.8.3v9l-1.8.1-4.5-6.9v5.6l1.1.1v1.3l-3.2.2v-1.3l.9-.3V10.5l-.9-.1V9Z" fill="#171717" />
    </>}
    {name === 'slack' && <>
      <path d="M8.5 2.5a2 2 0 0 0 0 4h2v-2a2 2 0 0 0-2-2ZM8.5 7.8H3.2a2 2 0 1 0 0 4h5.3a2 2 0 0 0 0-4Z" fill="#36C5F0" />
      <path d="M21.5 8.5a2 2 0 0 0-4 0v2h2a2 2 0 0 0 2-2ZM16.2 8.5V3.2a2 2 0 1 0-4 0v5.3a2 2 0 0 0 4 0Z" fill="#2EB67D" />
      <path d="M15.5 21.5a2 2 0 0 0 0-4h-2v2a2 2 0 0 0 2 2ZM15.5 16.2h5.3a2 2 0 1 0 0-4h-5.3a2 2 0 0 0 0 4Z" fill="#ECB22E" />
      <path d="M2.5 15.5a2 2 0 0 0 4 0v-2h-2a2 2 0 0 0-2 2ZM7.8 15.5v5.3a2 2 0 1 0 4 0v-5.3a2 2 0 0 0-4 0Z" fill="#E01E5A" />
    </>}
    {name === 'figma' && <>
      <circle cx="15.5" cy="12" r="3.5" fill="#1ABCFE" />
      <path d="M8.5 1.5H12v7H8.5a3.5 3.5 0 1 1 0-7Z" fill="#F24E1E" />
      <path d="M12 1.5h3.5a3.5 3.5 0 1 1 0 7H12v-7Z" fill="#FF7262" />
      <path d="M8.5 8.5H12v7H8.5a3.5 3.5 0 1 1 0-7Z" fill="#A259FF" />
      <path d="M8.5 15.5H12V19a3.5 3.5 0 1 1-3.5-3.5Z" fill="#0ACF83" />
    </>}
    {name === 'drive' && <>
      <path d="M8 2h8l8 14h-8L8 2Z" fill="#FFC107" />
      <path d="M8 2 0 16l4 7 8-14-4-7Z" fill="#0F9D58" />
      <path d="m4 23 4-7h16l-4 7H4Z" fill="#4285F4" />
    </>}
  </svg>
</span>
