---
// Minimal geometric line icons. Stroke-based, currentColor, 1.5 stroke.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls = "" } = Astro.props;
const paths: Record<string, string> = {
  arrow: '<path d="M4 10h12M11 5l5 5-5 5"/>',
  "arrow-up-right": '<path d="M6 14 14 6M7 6h7v7"/>',
  chevron: '<path d="m5 8 5 5 5-5"/>',
  "chevron-right": '<path d="m8 5 5 5-5 5"/>',
  search: '<circle cx="9" cy="9" r="5.5"/><path d="m17 17-3.6-3.6"/>',
  check: '<path d="m4 10 4 4 8-9"/>',
  x: '<path d="M5 5l10 10M15 5 5 15"/>',
  plus: '<path d="M10 4v12M4 10h12"/>',
  alert: '<path d="M10 2 1 18h18L10 2z"/><path d="M10 8v4M10 15h.01"/>',
  info: '<circle cx="10" cy="10" r="8"/><path d="M10 9v5M10 6h.01"/>',
  terminal: '<rect x="2" y="3" width="16" height="14" rx="1.5"/><path d="m6 8 3 3-3 3M11 14h4"/>',
  copy: '<rect x="6" y="6" width="10" height="10" rx="1.5"/><path d="M4 12V5a1 1 0 0 1 1-1h7"/>',
  file: '<path d="M5 2h6l4 4v12H5z"/><path d="M11 2v4h4"/>',
  folder: '<path d="M2 5.5A1.5 1.5 0 0 1 3.5 4H8l2 2h6.5A1.5 1.5 0 0 1 18 7.5v7A1.5 1.5 0 0 1 16.5 16h-13A1.5 1.5 0 0 1 2 14.5z"/>',
  menu: '<path d="M3 6h14M3 10h14M3 14h14"/>',
  filter: '<path d="M3 5h14l-5 6v4l-4 2v-6z"/>',
  external: '<path d="M8 4H4v12h12v-4M12 4h4v4M16 4l-7 7"/>',
  bolt: '<path d="M11 2 4 11h5l-1 7 7-9h-5z"/>',
  grid: '<rect x="3" y="3" width="6" height="6"/><rect x="11" y="3" width="6" height="6"/><rect x="3" y="11" width="6" height="6"/><rect x="11" y="11" width="6" height="6"/>',
};
const body = paths[name] ?? "";
---
<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
  set:html={body}
/>
