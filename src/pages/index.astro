---
import StyleGuide from "../layouts/StyleGuide.astro";
import Icon from "../components/Icon.astro";
import MediaSystem from "../components/MediaSystem.astro";

// Code snippets kept as constants so literal braces render cleanly.
const gradAtmosphere = `background:
  radial-gradient(
    ellipse 200% 100% at 50% 50%,
    #ffffff 0%,
    rgba(255,255,255,0) 80%
  ),
  linear-gradient(
    180deg,
    #0058ef 0%,
    rgba(255,255,255,0.8) 60%
  );`;

const gridSnippet = `--grid-line: rgba(26, 27, 28, 0.08);

background-image:
  linear-gradient(var(--grid-line) 1px, transparent 1px),
  linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
background-size: 140px 160px;`;

const apiSnippet = `{
  "site": "acme.answer.cloud",
  "question": "Do you offer a free plan?",
  "answered": true,
  "sources": [
    { "path": "/pricing/", "title": "Pricing", "cited": true }
  ],
  "surfaces": ["site", "chatgpt", "gemini"]
}`;

const typeScale = [
  { name: "Page title", cls: "page-title", size: "32px", lh: "1.15", w: "600" },
  { name: "Heading 1", cls: "h1", size: "28px", lh: "1.2", w: "600" },
  { name: "Heading 2", cls: "h2", size: "24px", lh: "1.25", w: "500" },
  { name: "Heading 3", cls: "h3", size: "20px", lh: "1.3", w: "500" },
  { name: "Heading 4", cls: "h4", size: "18px", lh: "1.35", w: "500" },
  { name: "Large body", cls: "body-lg", size: "18px", lh: "1.5", w: "400" },
  { name: "Body", cls: "body", size: "16px", lh: "1.55", w: "400" },
  { name: "Small body", cls: "body-sm", size: "14px", lh: "1.5", w: "400" },
  { name: "Caption", cls: "caption", size: "12px", lh: "1.4", w: "400" },
];

const palette = [
  { name: "Accent", val: "#2E7BFF", var: "--color-accent" },
  { name: "Accent deep", val: "#0058EF", var: "--color-accent-deep" },
  { name: "Ink", val: "#1A1B1C", var: "--color-ink" },
  { name: "Muted", val: "#667085", var: "--color-muted" },
  { name: "Cream", val: "#F6F5F4", var: "--color-cream" },
  { name: "Gray", val: "#F7F8F9", var: "--color-gray" },
  { name: "White", val: "#FFFFFF", var: "--color-white" },
];

const semantic = [
  ["Primary text", "--text-primary", "#1A1B1C"],
  ["Secondary text", "--text-secondary", "#3A3D40"],
  ["Muted text", "--text-muted", "#667085"],
  ["Page background", "--bg-page", "#FFFFFF"],
  ["Alt section bg", "--bg-alt", "#F6F5F4"],
  ["Border subtle", "--border-subtle", "rgba(26,27,28,.10)"],
  ["Border default", "--border-default", "rgba(26,27,28,.16)"],
  ["Divider", "--divider", "rgba(26,27,28,.10)"],
  ["Interactive", "--interactive", "#0058EF"],
  ["Focus ring", "--focus-ring", "rgba(46,123,255,.45)"],
  ["Disabled", "--disabled-text", "#A2A9B3"],
  ["Success", "--success", "#147A4B"],
  ["Warning", "--warning", "#9A6400"],
  ["Error", "--error", "#C0362C"],
];

const spacing = [4, 8, 12, 16, 24, 32, 48, 64, 80, 96];

const principles = [
  { n: "01", t: "Structure over decoration", d: "Hierarchy comes from grid, weight, spacing, and thin rules — not shadows or ornament." },
  { n: "02", t: "Restrained typography", d: "A compact scale that never exceeds 32px. Confidence through precision, not size." },
  { n: "03", t: "Intentional blue", d: "Accent reserved for actions, selection, links, and focus. Everything else stays neutral." },
  { n: "04", t: "Editorial, not promotional", d: "Left-aligned, information-dense layouts that read like technical documentation." },
];
---

<StyleGuide
  title="answer.cloud — Brand style guide & UI design system"
  description="The default brand style guide and UI design system for answer.cloud sites: color, typography, layout, components, and technical interface patterns."
>
  {/* ============================ 1. HERO / OVERVIEW ==================== */}
  <section class="hero bg-atmosphere">
    <div class="hero-grid grid-faded">
      <div class="container hero-inner">
        <span class="eyebrow">Brand system · v1.0 · 2026</span>
        <h1 class="page-title mt-4">answer.cloud design system</h1>
        <p class="body-lg reading mt-6">
          The default brand style guide for answer.cloud sites — the platform that turns a website
          into an answer engine. A restrained, technical, editorial system built on a compact type
          scale, a structured grid, and intentional use of blue.
        </p>
        <div class="row mt-8">
          <a class="btn btn-primary" href="#color">Explore tokens <Icon name="arrow" size={14} /></a>
          <a class="btn btn-secondary" href="#components">Component preview</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================ 2. BRAND OVERVIEW ==================== */}
  <div class="container">
    <section class="section" id="brand" style="border-top:0;">
      <div class="section-head">
        <span class="section-index">01</span>
        <div>
          <span class="eyebrow">Foundations</span>
          <h2 class="h1 mt-2">Brand overview</h2>
        </div>
      </div>
      <div class="grid-2">
        <p class="body-lg reading">
          answer.cloud turns a website into an answer engine — your answers on your site and
          inside LLMs like ChatGPT and Gemini. The visual language is quiet and precise: it should
          feel intelligent and functional, closer to a reference manual than a marketing page.
          Content sits directly on the page, aligned to a strong grid, separated by thin rules
          rather than cards.
        </p>
        <div class="stack">
          <p class="body reading muted">
            Use this system as the default starting point for any answer.cloud site. It favors
            left-aligned, multi-column information layouts, generous but controlled whitespace,
            and a deliberate, sparing use of accent blue.
          </p>
          <div class="meta-row">
            <div class="cell"><span class="k">Voice</span><span class="v">Technical, exact</span></div>
            <div class="cell"><span class="k">Density</span><span class="v">High, readable</span></div>
            <div class="cell"><span class="k">Tone</span><span class="v">Editorial</span></div>
          </div>
        </div>
      </div>
    </section>

    {/* ============================ 3. PRINCIPLES ==================== */}
    <section class="section" id="principles">
      <div class="section-head">
        <span class="section-index">02</span>
        <div><span class="eyebrow">Foundations</span><h2 class="h1 mt-2">Design principles</h2></div>
      </div>
      <div class="feature-grid" style="grid-template-columns:repeat(4,1fr);">
        {principles.map((p) => (
          <div class="feature-module">
            <div class="idx">{p.n}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ============================ 4. LOGO ==================== */}
    <section class="section" id="logo">
      <div class="section-head">
        <span class="section-index">03</span>
        <div><span class="eyebrow">Foundations</span><h2 class="h1 mt-2">Logo & usage</h2></div>
      </div>
      <div class="grid-3">
        <div class="panel logo-tile">
          <span class="logo-lockup">
            <span class="brand-mark-lg"></span>
            <span>answer<span style="color:var(--color-accent)">.</span>cloud</span>
          </span>
          <span class="caption">Primary lockup — light</span>
        </div>
        <div class="panel logo-tile" style="background:var(--bg-inverse);color:#fff;">
          <span class="logo-lockup" style="color:#fff;">
            <span class="brand-mark-lg"></span>
            <span>answer<span style="color:var(--color-accent)">.</span>cloud</span>
          </span>
          <span class="caption" style="color:rgba(255,255,255,.6)">On ink</span>
        </div>
        <div class="panel logo-tile">
          <span class="brand-mark-lg" style="width:40px;height:40px;"></span>
          <span class="caption">Mark only — favicons, avatars</span>
        </div>
      </div>
      <ul class="usage-rules mt-6">
        <li><Icon name="check" size={16} class="ok" /> Keep clear space of at least the mark height on all sides.</li>
        <li><Icon name="check" size={16} class="ok" /> Use the mark alone below 24px lockup width.</li>
        <li><Icon name="x" size={16} class="no" /> Do not recolor the mark, add shadows, or stretch the lockup.</li>
      </ul>
      <p class="caption mt-4">Placeholder mark — replace with the production logo asset.</p>
    </section>
  </div>

  {/* ============================ 5. COLOR ==================== */}
  <div class="container">
    <section class="section" id="color">
      <div class="section-head">
        <span class="section-index">04</span>
        <div><span class="eyebrow">Tokens</span><h2 class="h1 mt-2">Color palette</h2></div>
      </div>
      <p class="body reading muted" style="margin-bottom:var(--space-8)">
        A neutral core with one intentional blue. Blue signals action, selection, links, focus,
        and small accents — it does not coat every component.
      </p>
      <div class="swatch-grid">
        {palette.map((c) => (
          <div class="swatch">
            <div class="chip" style={`background:${c.val}`}></div>
            <div class="name">{c.name}</div>
            <div class="val">{c.val}</div>
            <div class="val">{c.var}</div>
          </div>
        ))}
      </div>

      <h3 class="h3 mt-8">Semantic tokens</h3>
      <div class="table-scroll mt-4">
        <table class="token-table">
          <thead>
            <tr><th>Role</th><th>Token</th><th>Value</th><th></th></tr>
          </thead>
          <tbody>
            {semantic.map((s) => (
              <tr>
                <td>{s[0]}</td>
                <td><span class="mono">{s[1]}</span></td>
                <td><span class="mono">{s[2]}</span></td>
                <td><span class="dot" style={`background:${s[2]}`}></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* ============================ 6. TYPOGRAPHY ==================== */}
    <section class="section" id="typography">
      <div class="section-head">
        <span class="section-index">05</span>
        <div><span class="eyebrow">Tokens</span><h2 class="h1 mt-2">Typography</h2></div>
      </div>
      <div class="grid-2" style="align-items:start;">
        <div>
          <span class="label">Primary typeface</span>
          <div class="specimen mt-3">Instrument Sans</div>
          <p class="body muted reading mt-3">
            Used for headings, body, navigation, labels, buttons, and interface. A monospace
            (JetBrains Mono) is reserved for code, commands, status values, and metadata.
          </p>
          <div class="row mt-4">
            <span class="tag">Regular 400</span>
            <span class="tag">Medium 500</span>
            <span class="tag">Semibold 600</span>
            <span class="tag mono">Mono 400/500</span>
          </div>
        </div>
        <div class="panel" style="padding:var(--space-6)">
          <span class="label">Rules</span>
          <ul class="rule-list mt-3">
            <li>Never exceed 32px.</li>
            <li>Keep heading steps small; use weight and rules for hierarchy.</li>
            <li>Sentence case for headings; uppercase only for small labels.</li>
            <li>Left-align headings; keep comfortable reading widths.</li>
            <li>Subtle negative tracking on headings only.</li>
          </ul>
        </div>
      </div>

      <div class="type-scale mt-8">
        {typeScale.map((t) => (
          <div class="type-row">
            <div class={t.cls}>Your answers, everywhere customers ask</div>
            <div class="type-meta">
              <span class="mono">{t.name}</span>
              <span class="mono muted">{t.size} · {t.lh} · {t.w}</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>

  {/* ============================ 7. GRADIENTS ==================== */}
  <div class="container">
    <section class="section" id="gradients">
      <div class="section-head">
        <span class="section-index">06</span>
        <div><span class="eyebrow">Surfaces</span><h2 class="h1 mt-2">Gradient system</h2></div>
      </div>
      <div class="grid-3">
        <div><div class="gradient-box gradient-accent"></div><p class="caption mt-3">Accent — 135°, #2E7BFF → #0058EF</p></div>
        <div><div class="gradient-box bg-atmosphere"></div><p class="caption mt-3">Blue atmosphere — layered radial + linear</p></div>
        <div><div class="gradient-box gradient-accent-fade" style="background-color:#fff;"></div><p class="caption mt-3">Accent fade — for section accents</p></div>
        <div><div class="gradient-box gradient-soft-surface"></div><p class="caption mt-3">Soft surface — white → cream</p></div>
        <div><div class="gradient-box gradient-section-transition"></div><p class="caption mt-3">Section transition — blue 8% → white</p></div>
        <div class="code-block">
          <div class="code-head"><span class="caption mono">blue-atmosphere.css</span><Icon name="copy" size={14} class="muted" /></div>
          <pre>{gradAtmosphere}</pre>
        </div>
      </div>
      <p class="caption mt-6">Use gradients for backgrounds and transitions — never as default text, card, or button fills.</p>
    </section>

    {/* ============================ 7b. GRID / BACKGROUNDS ==================== */}
    <section class="section" id="backgrounds">
      <div class="section-head">
        <span class="section-index">07</span>
        <div><span class="eyebrow">Surfaces</span><h2 class="h1 mt-2">Grid & background treatments</h2></div>
      </div>
      <div class="grid-2" style="align-items:start;">
        <div class="grid-preview grid-faded">
          <div class="grid-preview-label"><span class="label">Technical grid</span><p class="caption mt-2">Thin, low-contrast, fades at edges. Behind selected sections only.</p></div>
        </div>
        <div class="code-block">
          <div class="code-head"><span class="caption mono">grid.css</span><Icon name="copy" size={14} class="muted" /></div>
          <pre>{gridSnippet}</pre>
        </div>
      </div>
    </section>

    {/* ============================ 8. LAYOUT GRID ==================== */}
    <section class="section" id="layout">
      <div class="section-head">
        <span class="section-index">08</span>
        <div><span class="eyebrow">Structure</span><h2 class="h1 mt-2">Layout grid</h2></div>
      </div>
      <div class="col-demo">
        {Array.from({ length: 12 }).map((_, i) => <div class="cell">{i + 1}</div>)}
      </div>
      <div class="meta-row mt-8">
        <div class="cell"><span class="k">Page max</span><span class="v">1440px</span></div>
        <div class="cell"><span class="k">Content</span><span class="v">1200–1280px</span></div>
        <div class="cell"><span class="k">Reading</span><span class="v">640–720px</span></div>
        <div class="cell"><span class="k">Gutters</span><span class="v">40 / 32 / 20</span></div>
        <div class="cell"><span class="k">Columns</span><span class="v">12 / 6 / 4</span></div>
      </div>
      <p class="caption mt-4">Resize the viewport — the demo grid collapses 12 → 6 → 4 columns at tablet and mobile breakpoints.</p>
    </section>

    {/* ============================ 9. SPACING ==================== */}
    <section class="section is-dense" id="spacing">
      <div class="section-head">
        <span class="section-index">09</span>
        <div><span class="eyebrow">Structure</span><h2 class="h1 mt-2">Spacing system</h2></div>
      </div>
      <div class="space-demo">
        {spacing.map((s) => (
          <div class="item">
            <div class="bar" style={`height:${s}px`}></div>
            <div class="mt-2">{s}</div>
          </div>
        ))}
      </div>
      <p class="body muted reading mt-8">
        A single scale of 4 → 96 governs inline gaps, component padding, gutters, and section
        spacing. Major sections use 64–96px vertically; technical interfaces use the smaller
        steps to stay dense.
      </p>
    </section>

    {/* ============================ 10. BORDERS / DIVIDERS ==================== */}
    <section class="section is-dense" id="borders">
      <div class="section-head">
        <span class="section-index">10</span>
        <div><span class="eyebrow">Structure</span><h2 class="h1 mt-2">Borders & dividers</h2></div>
      </div>
      <div class="demo-grid">
        <div class="demo-tile"><div class="box" style="border-color:var(--border-subtle);background:transparent;"></div>--border-subtle · .10</div>
        <div class="demo-tile"><div class="box" style="border-color:var(--border-default);background:transparent;"></div>--border-default · .16</div>
        <div class="demo-tile"><div class="box" style="border-color:var(--border-strong);background:transparent;"></div>--border-strong · .28</div>
        <div class="demo-tile" style="background:var(--bg-inverse);color:rgba(255,255,255,.7)"><div class="box" style="border-color:var(--border-inverse);background:transparent;"></div>--border-inverse</div>
      </div>
      <p class="caption mt-6">Prefer borders and background changes over shadows to separate content.</p>
    </section>

    {/* ============================ 11. RADII / SHADOWS ==================== */}
    <section class="section" id="radii">
      <div class="section-head">
        <span class="section-index">11</span>
        <div><span class="eyebrow">Structure</span><h2 class="h1 mt-2">Corner radii & shadows</h2></div>
      </div>
      <div class="grid-2" style="align-items:start;">
        <div>
          <span class="label">Radii</span>
          <div class="demo-grid mt-4">
            <div class="demo-tile"><div class="box" style="border-radius:2px"></div>Small · 2px</div>
            <div class="demo-tile"><div class="box" style="border-radius:4px"></div>Standard · 4px</div>
            <div class="demo-tile"><div class="box" style="border-radius:8px"></div>Large · 8px</div>
            <div class="demo-tile"><div class="box" style="border-radius:999px;height:32px;"></div>Pill · tags only</div>
          </div>
        </div>
        <div>
          <span class="label">Shadows — float only</span>
          <div class="shadow-demo mt-4">
            <div class="shadow-tile" style="box-shadow:var(--shadow-popover)">Popover / dropdown</div>
            <div class="shadow-tile" style="box-shadow:var(--shadow-modal)">Modal</div>
          </div>
          <p class="caption mt-4">Never apply shadows to ordinary cards, sections, buttons, or inputs.</p>
        </div>
      </div>
    </section>
  </div>

  {/* ============================ 12. BUTTONS & LINKS ==================== */}
  <div class="container" id="components">
    <section class="section is-dense" id="buttons">
      <div class="section-head">
        <span class="section-index">12</span>
        <div><span class="eyebrow">Components</span><h2 class="h1 mt-2">Buttons & links</h2></div>
      </div>
      <div class="grid-2" style="align-items:start;">
        <div>
          <span class="label">Variants</span>
          <div class="row mt-4">
            <button class="btn btn-primary">Primary</button>
            <button class="btn btn-secondary">Secondary</button>
            <button class="btn btn-outline">Outline</button>
            <button class="btn btn-text">Text link</button>
            <button class="btn btn-icon" aria-label="Add"><Icon name="plus" size={16} /></button>
            <button class="btn btn-destructive">Delete</button>
            <button class="btn btn-secondary" disabled>Disabled</button>
          </div>
          <span class="label mt-8" style="display:block;">Primary — states</span>
          <div class="row mt-4">
            <button class="btn btn-primary">Default</button>
            <button class="btn btn-primary" style="background:var(--interactive-hover)">Hover</button>
            <button class="btn btn-primary" style="background:var(--interactive-active)">Active</button>
            <button class="btn btn-primary" style="outline:2px solid var(--focus-outline);outline-offset:2px;">Focus</button>
            <button class="btn btn-primary" disabled>Disabled</button>
          </div>
          <p class="caption mt-6">Compact, rectangular, ≤44px tall, 13–14px medium text. No gradient fills or heavy shadows.</p>
        </div>
        <div>
          <span class="label">Links</span>
          <div class="stack mt-4">
            <p class="body">An <a class="link-inline" href="#">inline text link</a> inside running copy.</p>
            <p><a class="link-arrow" href="#">Read the AEO guide <Icon name="arrow" size={14} class="arrow" /></a></p>
            <p><a class="link-util" href="#">Utility link</a></p>
            <p><a class="link-ref" href="#">llms.txt · auto-generated</a></p>
          </div>
          <p class="caption mt-6">Interactivity is never signalled by color alone — underlines, borders, and arrow motion reinforce it.</p>
        </div>
      </div>
    </section>

    {/* ============================ 13. FORMS ==================== */}
    <section class="section is-dense" id="forms">
      <div class="section-head">
        <span class="section-index">13</span>
        <div><span class="eyebrow">Components</span><h2 class="h1 mt-2">Form elements</h2></div>
      </div>
      <div class="grid-3" style="align-items:start;">
        <div class="field">
          <label class="field-label" for="f1">Workspace name</label>
          <input class="input" id="f1" type="text" placeholder="acme-research" />
          <p class="field-hint">Lowercase, DNS-safe. Used in your subdomain.</p>
        </div>
        <div class="field">
          <label class="field-label" for="f2">Search</label>
          <div class="search-input">
            <span class="search-icon"><Icon name="search" size={16} /></span>
            <input class="input" id="f2" type="search" placeholder="Search documentation" />
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="f3">Region</label>
          <div class="select-wrap">
            <select class="select" id="f3">
              <option>us-east</option><option>eu-west</option><option>ap-south</option>
            </select>
            <span class="chevron"><Icon name="chevron" size={16} /></span>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="f4">API key</label>
          <input class="input is-error" id="f4" type="text" value="aeo_host_xxx" aria-invalid="true" />
          <p class="field-error-text"><Icon name="alert" size={14} /> Key is invalid or expired.</p>
        </div>
        <div class="field">
          <label class="field-label" for="f5">Custom domain</label>
          <input class="input" id="f5" type="text" value="ai.acme.com" />
          <p class="field-success-text"><Icon name="check" size={14} /> Domain verified.</p>
        </div>
        <div class="field">
          <label class="field-label" for="f6">Disabled</label>
          <input class="input" id="f6" type="text" value="Managed by org" disabled />
        </div>
        <div class="field" style="grid-column:1 / -1;">
          <label class="field-label" for="f7">System prompt</label>
          <textarea class="textarea" id="f7" placeholder="Answer strictly from provided sources…"></textarea>
        </div>
        <div class="field">
          <span class="field-label">Options</span>
          <div class="stack" style="gap:var(--space-3)">
            <label class="choice"><input type="checkbox" checked /> Answer only from your content</label>
            <label class="choice"><input type="checkbox" /> Surface answers in LLMs</label>
          </div>
        </div>
        <div class="field">
          <span class="field-label">Index mode</span>
          <div class="stack" style="gap:var(--space-3)">
            <label class="choice"><input type="radio" name="idx" checked /> Incremental</label>
            <label class="choice"><input type="radio" name="idx" /> Full re-index</label>
          </div>
        </div>
        <div class="field">
          <span class="field-label">Chat widget</span>
          <label class="toggle mt-2"><input type="checkbox" checked /><span class="track"></span> Enabled</label>
          <div class="file-upload mt-6">
            <Icon name="file" size={18} class="muted" />
            <div class="body-sm">Drop <span class="mono">llms.txt</span> override<br /><span class="caption">or click to browse</span></div>
          </div>
        </div>
      </div>
    </section>
