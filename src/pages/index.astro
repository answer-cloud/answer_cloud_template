---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Workspace from '../components/Workspace.astro';
import ProjectSetup from '../components/ProjectSetup.astro';
import DeliverySummary from '../components/DeliverySummary.astro';
import IntegrationLogo from '../components/IntegrationLogo.astro';
import GradientBackdrop from '../components/GradientBackdrop.astro';
import '../styles/home.css';
const faqs = [
  ['What is SaaaaS?', 'SaaaaS is an illustrative workspace product and a reusable SaaS website template for Answer Cloud. It brings a polished home page, a living style guide, and a shared design system together in one Astro project.'],
  ['Can I make this feel like my own brand?', 'Absolutely. Change the name, copy, and shared design tokens to make it yours. Colors, type, spacing, and components all have a home in the style guide.'],
  ['Does the workspace demo really work?', 'The hero workspace is a visual preview of the product. Choose Try the demo for a short interactive product tour. Nothing creates an account or saves your work.'],
  ['Is this ready for smaller screens?', 'Yes. The layout adapts from a spacious desktop canvas to a compact mobile experience, including navigation, project views, pricing, and the style guide.'],
  ['How do I turn this into my next product site?', 'Start with the style guide, replace the example product content and plans, and connect your own signup or demo flow. When you are ready, build the Astro source and publish it with Answer Cloud.'],
];
const plans = [
  {name:'A little start', description:'For your next good idea.', price:'0', features:['A space to make your own','Projects and simple task boards','The essentials, beautifully done'], cta:'Take a look', featured:false},
  {name:'A little momentum', description:'For a team finding its flow.', price:'19', features:['Everything in A little start','Shared projects and team updates','More room for your best work','Your tools, working together'], cta:'Find your flow', featured:true},
  {name:'A little more', description:'For bigger things, together.', price:'39', features:['Everything in A little momentum','Flexible spaces for every team','A helping hand when you need it','Room to grow at your own pace'], cta:'Explore the possibilities', featured:false},
];
---
<SiteLayout title="SaaaaS — A little less busywork. A lot more possibility." description="Meet a calmer home for your projects, ideas, and people. SaaaaS is a thoughtful SaaS template for your next big thing.">
  <div id="top"></div>
  <section class="hero container" aria-labelledby="hero-title">
    <a class="hero-announcement" href="#workspace"><span class="announcement-dot"></span>A calmer way to work <span class="announcement-divider"></span> Meet SaaaaS <Icon name="arrow" size={13}/></a>
    <h1 id="hero-title"><span class="hero-title-line">A little less busywork.</span><br/><span class="hero-title-line">A lot more possibility.</span></h1>
    <p>Your projects, ideas, and people. Finally in the same place.<br class="desktop-break"/> Make space for the work you actually love.</p>
    <div class="hero-actions"><button class="button button-primary" data-demo-open>Find your flow <Icon name="arrow" size={15}/></button><a class="button button-secondary" href="#workspace"><svg class="play-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7 4 9 6-9 6V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg> See it in action</a></div>
    <span class="hero-note">A little simpler. A lot better together.</span>
    <div class="teams-strip"><p>FOR TEAMS WITH GOOD THINGS TO DO</p><div class="team-types"><span><Icon name="sparkle" size={22}/> Creatives</span><span><Icon name="grid" size={21}/> Product people</span><span class="team-type-serif">Studio folk.</span><span><Icon name="bolt" size={22}/> Big thinkers</span><span class="team-type-mono">& you.</span></div></div>
  </section>
  <section class="product-stage" id="workspace" aria-label="Product workspace preview" data-aeo-exclude><div class="workspace-wrap" data-scroll-drift><Workspace/></div><GradientBackdrop/></section>
  <section class="section how-section" id="how-it-works"><div class="container"><div class="section-heading" data-reveal><span class="eyebrow">GOOD WORK, LESS WORK</span><h2 class="section-title">From a spark of an idea<br/>to a very good day.</h2><p>Less switching tabs. More making things happen.</p></div><div class="steps-grid" data-reveal-group>
    <article class="step-card"><div class="step-label"><span>01</span><Icon name="plus" size={18}/></div><h3>Make a little space.</h3><p>Bring your ideas out of your head and into a shared home. Start messy. Start small. Just start.</p><div class="step-visual space-visual"><ProjectSetup/></div></article>
    <article class="step-card"><div class="step-label"><span>02</span><Icon name="grid" size={18}/></div><h3>Find your rhythm.</h3><p>Give the big picture a few small steps. Keep the next thing clear, and the whole team in the loop.</p><div class="step-visual rhythm-visual"><div><span class="check-circle"><Icon name="check" size={12}/></span> A little planning <span>✓</span></div><div><span class="check-circle"><Icon name="check" size={12}/></span> A little making <span>✓</span></div><div><span class="empty-circle"></span> A lot of possibility <Icon name="arrow" size={12}/></div></div></article>
    <article class="step-card"><div class="step-label"><span>03</span><Icon name="arrow-up-right" size={18}/></div><h3>Move good things forward.</h3><p>Share the progress, celebrate the little wins, and make room for whatever comes next.</p><div class="step-visual forward-visual"><DeliverySummary/></div></article>
  </div></div></section>
  <section class="section" id="features"><div class="container"><div class="section-heading" data-reveal><span class="eyebrow">THOUGHTFULLY PUT TOGETHER</span><h2 class="section-title">Everything you need.<br/>Nothing in your way.</h2><p>The right tools, with a little room to breathe.</p></div><div class="features-grid" data-reveal-group>
    <article class="feature-card feature-focus"><div class="feature-copy"><span class="feature-icon"><Icon name="grid" size={20}/></span><h3>The big picture.<br/>The little details.</h3><p>See it your way. Move between boards, lists, and timelines without losing the thread.</p></div><div class="focus-art"><div class="focus-toolbar"><span>Website refresh</span><span>•••</span></div><div class="focus-tabs"><span>Board</span><span>List</span><span>Timeline</span></div><div class="focus-columns"><div><i></i><b></b><b></b></div><div><i></i><b></b></div><div><i></i><b></b><b></b></div></div><span class="floating-update"><Icon name="check" size={13}/> Everything, in a good place.</span></div></article>
    <article class="feature-card feature-team"><div class="feature-copy"><span class="feature-icon"><Icon name="message" size={20}/></span><h3>In the loop.<br/>Out of your inbox.</h3><p>Keep conversations close to the work. Fewer follow-ups. More “we've got this.”</p></div><div class="conversation-art"><div class="comment-bubble"><span class="comment-avatar">AK</span><div><b>Alex Kim <small>Just now</small></b><p>A little something I've been working on ✨</p><span class="comment-attachment"><Icon name="file" size={13}/> home-page-v2.fig <Icon name="check" size={12}/></span></div></div><div class="reply-bubble"><span class="comment-avatar peach">JL</span><div><b>Jamie Lee</b><p>This feels like us. Let's make it happen.</p></div></div><span class="reaction"><svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13.8 6.4c0 3-5.8 6.4-5.8 6.4s-5.8-3.4-5.8-6.4a3.1 3.1 0 0 1 5.8-1.5 3.1 3.1 0 0 1 5.8 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg> &nbsp; 3 &nbsp; <Icon name="message" size={11}/> &nbsp; 2</span></div></article>
    <article class="feature-card feature-small"><span class="feature-icon"><Icon name="search" size={21}/></span><h3>Find your needle.</h3><p>Ideas, files, and that thing someone shared last week. A little easier to find.</p><div class="mini-search"><Icon name="search" size={15}/><span>That very good idea</span><kbd>↵</kbd></div></article>
    <article class="feature-card feature-small"><span class="feature-icon"><Icon name="bolt" size={21}/></span><h3>Your tools. In tune.</h3><p>Make room for the tools you already love. Good company makes good work.</p><div class="integration-icons" role="group" aria-label="Illustrative integrations"><IntegrationLogo name="notion" /><IntegrationLogo name="slack" /><IntegrationLogo name="figma" /><IntegrationLogo name="drive" /><span class="integration-add" aria-hidden="true"><Icon name="plus" size={15} /></span></div></article>
    <article class="feature-card feature-small"><span class="feature-icon"><Icon name="sparkle" size={21}/></span><h3>A little more you.</h3><p>A home for your team's own way of doing things. No one-size-fits-all required.</p><div class="theme-colors"><i></i><i></i><i></i><i></i><i><Icon name="check" size={14}/></i><span>Your space. Your style.</span></div></article>
  </div><p class="feature-footnote">A few possibilities for your next product. All product content is illustrative.</p></div></section>
  <section class="quiet-statement" data-reveal><div class="container"><p>Because your best work<br/>deserves a little more <em>space.</em></p><span>Less noise. More of what matters.</span></div></section>
  <section class="section pricing-section" id="pricing"><div class="container"><div class="section-heading" data-reveal><span class="eyebrow">ROOM TO START. ROOM TO GROW.</span><h2 class="section-title">Big possibilities.<br/>Little commitments.</h2><p>Simple example plans for a product that grows with you.</p></div><div class="pricing-grid" data-reveal-group>{plans.map(plan=><article class:list={['pricing-card', {'pricing-featured':plan.featured}]}>{plan.featured && <span class="plan-ribbon"><Icon name="sparkle" size={12}/> A happy middle ground</span>}<h3>{plan.name}</h3><p>{plan.description}</p><div class="plan-price"><span>$</span>{plan.price}<small>/ person / month</small></div><button class:list={['button',plan.featured?'button-primary':'button-secondary']} data-demo-open>{plan.cta}<Icon name="arrow" size={14}/></button><div class="plan-rule"></div><span class="plan-list-title">A LITTLE OF WHAT'S INCLUDED</span><ul>{plan.features.map(feature=><li><Icon name="check" size={14}/>{feature}</li>)}</ul></article>)}</div><p class="pricing-note">These are illustrative plans. Explore the demo to see the template in action.</p></div></section>
  <section class="section faq-section" id="faq"><div class="container faq-layout" data-reveal><div><span class="eyebrow">A LITTLE MORE CLARITY</span><h2>Good questions.<br/>Simple answers.</h2><p>Everything else you might be wondering.</p><a class="text-link" href="/style-guide/">Explore the style guide <Icon name="arrow" size={15}/></a></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<Icon name="plus" size={17}/></summary><p>{a}</p></details>)}</div></div></section>
  <section class="closing-section"><div class="container closing-card" data-reveal>
    <div class="closing-content"><span class="eyebrow">YOUR NEXT GOOD THING STARTS HERE</span><h2>Make room for<br/>what comes next.</h2><p>One calm place for projects, people, and good ideas.</p></div>
    <div class="closing-actions"><button class="button button-primary" data-demo-open>Explore the workspace <Icon name="arrow" size={15}/></button><span class="closing-note">Take a look around.</span></div>
  </div></section>
</SiteLayout>

<script>
  // Finish entrances when keyboard users arrive; keep them finished on blur.
  document.querySelectorAll<HTMLElement>('.hero, .workspace-wrap > .workspace').forEach(root => {
    root.addEventListener('focusin', () => {
      root.getAnimations({ subtree: true }).forEach(animation => {
        if (animation instanceof CSSAnimation && animation.animationName.startsWith('hero-')) animation.finish();
      });
    }, { once: true });
  });
</script>
