---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import '../styles/guide.css';

const colors = [
  { name: 'Ink', token: '--color-ink', hex: '#171717', dark: true },
  { name: 'Muted', token: '--color-muted', hex: '#666666', dark: true },
  { name: 'Border', token: '--color-border', hex: '#E8E8E8' },
  { name: 'Soft', token: '--color-soft', hex: '#F8F8F8' },
  { name: 'Blue', token: '--color-blue', hex: '#E3EDFF' },
  { name: 'Lilac', token: '--color-lilac', hex: '#E9E0FF' },
  { name: 'Peach', token: '--color-peach', hex: '#FFE6D5' },
  { name: 'Mint', token: '--color-mint', hex: '#DFF5E8' },
];
const gradients = [
  { name: 'Aurora', token: '--gradient-aurora', purpose: 'The signature product backdrop.' },
  { name: 'Dawn', token: '--gradient-dawn', purpose: 'A warm spark for new ideas.' },
  { name: 'Sky', token: '--gradient-sky', purpose: 'A little lift for product moments.' },
  { name: 'Meadow', token: '--gradient-meadow', purpose: 'Room to grow, in full color.' },
];
const sections = [
  ['overview', 'Overview'], ['colors', 'Colors'], ['typography', 'Typography'],
  ['spacing', 'Spacing & shape'], ['buttons', 'Buttons'], ['forms', 'Forms'],
  ['components', 'Components'], ['chat', 'Chat'], ['principles', 'Principles'],
];
const spacing = [4, 8, 12, 16, 24, 32, 48, 64];
---

<SiteLayout title="Style guide — SaaaaS" description="The foundations, components, and interaction patterns behind the SaaaaS Answer Cloud template." page="guide">
  <div class="guide-shell container">
    <aside class="guide-sidebar" aria-label="Style guide navigation">
      <a href="#overview" class="guide-system-label"><BrandMark size={16} class="guide-system-mark"/> Design system <span class="guide-version">1.1</span></a>
      <nav class="guide-nav" aria-label="On this page">
        {sections.map(([id, label], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{label}</a>)}
      </nav>
      <div class="guide-sidebar-note"><Icon name="grid" size={18} /><p>One system.<br />A little room to make it yours.</p></div>
    </aside>

    <div class="guide-content">
      <section id="overview" class="guide-intro guide-anchor">
        <div class="guide-intro-meta"><span class="eyebrow">THE SAAAAS SYSTEM</span><span class="guide-tag">Version 1.1</span></div>
        <h1>Less noise.<br /><span class="muted">More clarity.</span></h1>
        <p class="guide-lead">A thoughtful starting point for your next SaaS. Luminous color, confident typography, and considered details that let your product do the talking.</p>
        <div class="guide-intro-bottom"><span><Icon name="check" size={15} /> Built for both pages</span><span><Icon name="check" size={15} /> Responsive by default</span><a href="/">See it in action <Icon name="arrow-up-right" size={14} /></a></div>
      </section>

      <section id="colors" class="guide-section guide-anchor">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">01 / FOUNDATIONS</span><h2>A little more color. A lot of character.</h2><p>Charcoal keeps things clear. Fresh accents and luminous gradients give the product its personality.</p></div>
        <div class="guide-swatches" data-reveal-group>
          {colors.map(color => <button class:list={['guide-swatch', { 'guide-swatch-dark': color.dark }]} type="button" data-copy-color={color.hex} aria-label={`${color.name} ${color.hex}, copy color`}>
            <span class="guide-swatch-color" style={`--swatch: var(${color.token})`}><Icon name="copy" size={16} /></span>
            <span class="guide-swatch-info"><strong>{color.name}</strong><span class="guide-hex">{color.hex}</span></span>
          </button>)}
        </div>
        <p class="guide-caption guide-copy-status" aria-live="polite" id="color-copy-status">Click a swatch to copy its hex value.</p>
        <div class="guide-color-note" data-reveal><Icon name="info" size={17} /><p>Use color for backgrounds and product moments. Keep body copy in Ink or Muted so it stays easy to read.</p></div>
        <div class="guide-subheading" data-reveal><h3>Our signature gradients.</h3><p>Rich at the edges. Soft where the content lives.</p></div>
        <div class="guide-gradients" data-reveal-group>
          {gradients.map(gradient => <div class="guide-gradient-card"><div class="guide-gradient-art" style={`background:var(${gradient.token})`} aria-hidden="true"></div><div class="guide-gradient-meta"><strong>{gradient.name}</strong><code>{gradient.token}</code><p>{gradient.purpose}</p></div></div>)}
        </div>
        <div class="guide-subheading" data-reveal><h3>A mark with a little momentum.</h3><p>The answer.cloud spark, with its original curves and signature blue.</p></div>
        <div class="guide-brand-grid" data-reveal-group><div class="guide-brand-tile"><span class="wordmark"><BrandMark size={34} class="brand-symbol"/>SaaaaS<span class="brand-period">.</span></span><span class="guide-caption">Primary lockup</span></div><div class="guide-brand-tile guide-brand-dark"><span class="wordmark"><BrandMark size={34} class="brand-symbol" color="#ffffff"/>SaaaaS<span class="brand-period">.</span></span><span class="guide-caption">Reversed lockup</span></div></div>
      </section>

      <section id="typography" class="guide-section guide-anchor">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">02 / TYPOGRAPHY</span><h2>Say it simply. Set it beautifully.</h2><p>Inter brings a clear, friendly voice to every screen. Mostly regular. Occasionally medium. Always readable.</p></div>
        <div class="guide-font-card" data-reveal>
          <div><span class="guide-caption">OUR EVERYDAY TYPEFACE</span><div class="guide-font-name">Inter</div><span class="guide-caption">Self-hosted variable font · 400 / 500 / 600</span></div>
          <div class="guide-font-specimen" aria-hidden="true">Aa<span>abcdefghijklm<br />nopqrstuvwxyz<br />0123456789</span></div>
        </div>
        <div class="guide-type-scale" data-reveal-group>
          <div class="guide-type-row"><div class="guide-type-meta"><strong>Display</strong><span>40–56 / 1.1 / 500</span></div><p class="guide-type-display">Make room for better.</p></div>
          <div class="guide-type-row"><div class="guide-type-meta"><strong>Section heading</strong><span>30–36 / 1.2 / 500</span></div><p class="guide-type-heading">Everything, together.</p></div>
          <div class="guide-type-row"><div class="guide-type-meta"><strong>Card heading</strong><span>24 / 1.3 / 500</span></div><p class="guide-type-card">A simpler way forward.</p></div>
          <div class="guide-type-row"><div class="guide-type-meta"><strong>Body</strong><span>16 / 1.6 / 400</span></div><p class="guide-type-body">Good software gets out of the way. Keep your message clear, your sentences short, and your next step obvious.</p></div>
          <div class="guide-type-row"><div class="guide-type-meta"><strong>Small / caption</strong><span>14 / 1.5 / 400</span></div><p class="guide-type-small">A little context, right when you need it.</p></div>
          <div class="guide-type-row"><div class="guide-type-meta"><strong>Eyebrow</strong><span>12 / 1.5 / 500</span></div><p class="eyebrow">THE DETAILS MAKE THE DIFFERENCE</p></div>
        </div>
      </section>

      <section id="spacing" class="guide-section guide-anchor">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">03 / SPACING & SHAPE</span><h2>A little breathing room.</h2><p>A four-pixel rhythm keeps things aligned. Rounded corners soften the edges without stealing the show.</p></div>
        <div class="guide-spacing-card" data-reveal>
          {spacing.map(space => <div class="guide-spacing-item"><span class="guide-caption">{space}</span><span class="guide-spacing-bar" style={`width:${space}px`}></span><code>{space / 16}rem</code></div>)}
        </div>
        <div class="guide-radius-grid" data-reveal-group>
          {[['6px', 'Small', '--radius-sm'], ['10px', 'Medium', '--radius-md'], ['16px', 'Large', '--radius-lg'], ['24px', 'Extra large', '--radius-xl']].map(([value, name, token]) => <div class="guide-radius-item"><div style={`border-radius:var(${token})`}></div><strong>{name}</strong><span class="guide-caption">{value}</span></div>)}
        </div>
        <div class="guide-layout-note" data-reveal><span class="guide-caption">LAYOUT</span><p><strong>1,180px</strong> content width <span>·</span> <strong>32px / 20px</strong> page gutters <span>·</span> <strong>64–104px</strong> section spacing</p></div>
      </section>

      <section id="buttons" class="guide-section guide-anchor">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">04 / BUTTONS</span><h2>One clear next step.</h2><p>A strong primary action, a quieter alternative, and enough space to make either feel easy.</p></div>
        <div class="guide-button-table" data-reveal>
          <div class="guide-button-table-head"><span>Variant</span><span>Default</span><span>Hover</span><span>Disabled</span></div>
          <div class="guide-button-table-row"><span class="guide-caption">Primary</span><button type="button" class="button button-primary button-small" data-demo-open>Get started <Icon name="arrow" size={14} /></button><button type="button" class="button button-primary button-small guide-force-hover" data-demo-open>Get started <Icon name="arrow" size={14} /></button><button class="button button-primary button-small" disabled>Get started <Icon name="arrow" size={14} /></button></div>
          <div class="guide-button-table-row"><span class="guide-caption">Secondary</span><button type="button" class="button button-secondary button-small" data-demo-open>Book a demo</button><button type="button" class="button button-secondary button-small guide-force-hover" data-demo-open>Book a demo</button><button class="button button-secondary button-small" disabled>Book a demo</button></div>
        </div>
        <div class="guide-button-sizes" data-reveal><span class="guide-caption">SIZES</span><button type="button" class="button button-primary" data-demo-open>Default button <Icon name="arrow" /></button><button type="button" class="button button-secondary button-small" data-demo-open>Small button</button><button type="button" class="guide-icon-button" aria-label="Open demo" data-demo-open><Icon name="plus" size={18} /></button></div>
        <p class="guide-caption">Tab to a button to see the focus state. Disabled buttons are intentionally unavailable.</p>
      </section>

      <section id="forms" class="guide-section guide-anchor">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">05 / FORMS</span><h2>Keep the conversation easy.</h2><p>Visible labels, helpful context, and feedback that tells people exactly what happened.</p></div>
        <div class="guide-form-grid" data-reveal-group>
          <form class="guide-form card" id="guide-example-form">
            <h3>Your workspace, your way.</h3><p class="muted">Try the form. This is a local demo.</p>
            <label class="field">Full name<input class="input" name="name" autocomplete="name" placeholder="Alex Morgan" required /></label>
            <label class="field">Work email<input class="input" name="email" type="email" autocomplete="email" placeholder="alex@company.com" required /><span class="guide-caption">Use any valid email format. Nothing is sent.</span></label>
            <label class="field">Team size<select class="input" name="team"><option>Just me</option><option>2–10 people</option><option>11–50 people</option><option>51+ people</option></select></label>
            <label class="guide-checkbox"><input type="checkbox" name="updates" /><span>Keep me in the loop with product updates.</span></label>
            <button type="submit" class="button button-primary">Create workspace <Icon name="arrow" /></button>
            <p class="guide-form-status" id="guide-form-status" role="status"></p>
          </form>
          <div class="guide-form-states">
            <span class="guide-caption">INPUT STATES</span>
            <label class="field">Default<input class="input" placeholder="Your workspace name" /></label>
            <label class="field">Focus example<input class="input guide-input-focus" value="A clear place to start" readonly /></label>
            <label class="field">Error example<input class="input guide-input-error" value="alex@" aria-invalid="true" aria-describedby="guide-email-error" readonly /><span id="guide-email-error" class="guide-error"><Icon name="alert" size={13} /> Enter a complete email address.</span></label>
            <label class="field">Disabled<input class="input" placeholder="Available after setup" disabled /></label>
          </div>
        </div>
      </section>

      <section id="components" class="guide-section guide-anchor">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">06 / COMPONENTS</span><h2>Small pieces. One language.</h2><p>Useful, adaptable building blocks. Each one belongs to the same simple system.</p></div>
        <div class="guide-component-grid" data-reveal-group>
          <article class="guide-feature-card card"><div class="guide-feature-art"><span class="guide-feature-orbit"></span><span class="guide-feature-icon"><Icon name="bolt" size={28} /></span><span class="guide-mini-label"><Icon name="check" size={12} /> All connected</span></div><div class="guide-feature-copy"><span class="eyebrow">LESS BUSYWORK</span><h3>Find your flow.</h3><p>Bring your work into one calm place. Focus on the ideas that move you forward.</p><button class="guide-text-button" type="button" data-demo-open>Explore the product <Icon name="arrow" size={15} /></button></div></article>
          <div class="guide-status-card card"><span class="guide-caption">BADGES & STATUS</span><div class="guide-badge-row"><span class="badge">New</span><span class="guide-status guide-status-success"><span></span> Published</span><span class="guide-status">Draft</span><span class="guide-status guide-status-warning">In review</span></div><div class="guide-alert"><Icon name="info" size={18} /><div><strong>A little helpful context.</strong><p>Use a quiet notice to add information without interrupting the task.</p></div></div><div class="guide-alert guide-alert-success"><Icon name="check" size={18} /><div><strong>You're all set.</strong><p>Your changes have been saved.</p></div></div></div>
        </div>
        <div class="guide-table-wrap" data-reveal><table class="guide-table"><caption>Workspace content <span>Illustrative data</span></caption><thead><tr><th scope="col">Name</th><th scope="col">Status</th><th scope="col">Owner</th><th scope="col">Updated</th></tr></thead><tbody><tr><th scope="row"><Icon name="file" size={16} /> Getting started</th><td><span class="guide-status guide-status-success"><span></span> Published</span></td><td>Alex M.</td><td>Just now</td></tr><tr><th scope="row"><Icon name="file" size={16} /> Your first project</th><td><span class="guide-status">Draft</span></td><td>Jamie L.</td><td>2 hours ago</td></tr><tr><th scope="row"><Icon name="file" size={16} /> Team handbook</th><td><span class="guide-status guide-status-warning">In review</span></td><td>Sam R.</td><td>Yesterday</td></tr></tbody></table></div>
        <div class="guide-disclosures" data-reveal><span class="guide-caption">DISCLOSURES</span><details open><summary>Can I make this template my own?<Icon name="plus" size={17} /></summary><p>Absolutely. Start with the color and typography tokens, then adapt the copy and components to your product. Both pages share the same foundations.</p></details><details><summary>How should I use the pastel colors?<Icon name="plus" size={17} /></summary><p>Use them sparingly in product illustrations, feature backgrounds, and small highlights. Keep important text dark and primary actions charcoal.</p></details><details><summary>What happens on smaller screens?<Icon name="plus" size={17} /></summary><p>Columns stack, page gutters tighten, and headings scale down. Controls stay easy to reach, and tables scroll within their own container.</p></details></div>
      </section>

      <section id="chat" class="guide-section guide-anchor">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">07 / CHAT</span><h2>A natural extension of your site.</h2><p>The same colors and type, in a calm conversation. A visible invitation, compact messages, and a composer that's always within reach.</p></div>
        <div class="guide-chat-stage" data-reveal>
          <div class="guide-chat-context"><h3>A little help,<br />right here.</h3><p>Keep answers readable and controls familiar.</p><button type="button" class="guide-chat-launcher" data-guide-chat-focus>Ask SaaaaS <Icon name="arrow" size={15} /></button></div>
          <div class="guide-chat-preview" aria-label="Local chat component preview">
            <div class="guide-chat-header"><div class="guide-chat-heading"><strong>Ask SaaaaS</strong><span>Template assistant</span></div><span class="guide-tag">Local demo</span></div>
            <div class="guide-chat-messages" id="guide-chat-messages" role="log" aria-label="Preview conversation" aria-live="polite"><p class="guide-chat-ai">Hi there. I can help you explore the SaaaaS template. What would you like to know?</p><p class="guide-chat-user">Where do I change the colors?</p><p class="guide-chat-ai">Start with the shared color tokens. Update them once, and the home page and style guide follow together.</p></div>
            <form class="guide-chat-form" id="guide-chat-form"><label class="visually-hidden" for="guide-chat-input">Ask about this template</label><input id="guide-chat-input" name="question" placeholder="Ask about this template…" maxlength="250" required autocomplete="off" /><button type="submit" aria-label="Send preview message"><Icon name="send" size={17} /></button></form>
            <p class="guide-chat-footnote">Local preview · messages stay on this page</p>
          </div>
        </div>
      </section>

      <section id="principles" class="guide-section guide-anchor guide-last-section">
        <div class="guide-section-heading" data-reveal><span class="eyebrow">08 / PRINCIPLES</span><h2>Thoughtful by default.</h2><p>The details that make the whole experience feel considered.</p></div>
        <div class="guide-principles" data-reveal-group><div><span>01</span><h3>Clarity comes first.</h3><p>One clear heading. One clear action. Give every element a reason to be here.</p></div><div><span>02</span><h3>Make space.</h3><p>Let content breathe. Group related things, and leave room between ideas.</p></div><div><span>03</span><h3>Welcome everyone.</h3><p>Readable contrast, visible focus, semantic structure, and respect for reduced motion.</p></div></div>
        <div class="guide-motion-note" data-reveal><span class="eyebrow">MOTION, WITH A LIGHT TOUCH</span><h3>A little movement. A natural rhythm.</h3><p>Headings rise into view, cards arrive in a short sequence, and the workspace gently follows the scroll. Reduced motion keeps everything still and readable.</p><div><span>Reveal <code>0.7s</code></span><span>Stagger <code>0.08s</code></span><span>Rise <code>22px / 14px</code></span></div></div>
        <a class="button button-secondary" href="/">Back to the home page <Icon name="arrow" /></a>
      </section>
    </div>
  </div>
</SiteLayout>

<script>
  const copyStatus = document.querySelector<HTMLElement>('#color-copy-status');
  document.querySelectorAll<HTMLButtonElement>('[data-copy-color]').forEach(button => {
    button.addEventListener('click', async () => {
      const color = button.dataset.copyColor || '';
      try {
        await navigator.clipboard.writeText(color);
        if (copyStatus) copyStatus.textContent = `${color} copied to clipboard.`;
      } catch {
        if (copyStatus) copyStatus.textContent = `Color value: ${color}. Select this value to copy it.`;
      }
    });
  });

  const exampleForm = document.querySelector<HTMLFormElement>('#guide-example-form');
  exampleForm?.addEventListener('submit', event => {
    event.preventDefault();
    const formData = new FormData(exampleForm);
    const name = String(formData.get('name') || '').trim().split(' ')[0] || 'there';
    const status = document.querySelector<HTMLElement>('#guide-form-status');
    if (status) status.textContent = `Looks good, ${name}. This demo is complete — no information was submitted.`;
  });

  const chatForm = document.querySelector<HTMLFormElement>('#guide-chat-form');
  const chatInput = document.querySelector<HTMLInputElement>('#guide-chat-input');
  const chatMessages = document.querySelector<HTMLElement>('#guide-chat-messages');
  document.querySelector('[data-guide-chat-focus]')?.addEventListener('click', () => {
    chatInput?.focus({ preventScroll: true });
    chatInput?.scrollIntoView({ block: 'nearest', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  });
  chatForm?.addEventListener('submit', event => {
    event.preventDefault();
    const question = chatInput?.value.trim();
    if (!question || !chatInput || !chatMessages) return;
    const message = document.createElement('p');
    message.className = 'guide-chat-user';
    message.textContent = question;
    chatMessages.append(message);
    const answer = document.createElement('p');
    answer.className = 'guide-chat-ai';
    const lower = question.toLowerCase();
    answer.textContent = /color|colour|palette/.test(lower)
      ? 'Our palette pairs charcoal and white with soft blue, lilac, peach, and mint. The Colors section has every value, ready to copy.'
      : /font|type/.test(lower)
      ? 'SaaaaS uses self-hosted Inter for body copy and interface elements, with regular and medium weights doing most of the work.'
      : /mobile|responsive/.test(lower)
      ? 'The template adapts to mobile with stacked layouts, smaller page gutters, fluid headings, and accessible controls.'
      : 'This is a local component preview with a few sample replies. Explore the style guide for colors, typography, forms, and reusable components.';
    chatMessages.append(answer);
    chatInput.value = '';
    chatMessages.scrollTop = chatMessages.scrollHeight;
    chatInput.focus();
  });
</script>
