---
interface Props {
  preset?: 'sculpture' | 'network' | 'landscape';
  color?: string;
  secondary?: string;
  animated?: boolean;
}
const { preset = 'sculpture', color, secondary, animated = true } = Astro.props;
---

<hero-scene style={{ color }} data-preset={preset} data-color={color} data-secondary={secondary} data-animated={String(animated)} data-state="static">
  <div class="scene-art" aria-hidden="true">
    <svg class="scene-fallback" viewBox="0 0 600 500" fill="none">
      {preset === 'sculpture' && <g stroke="currentColor" stroke-width="22">
        <ellipse cx="300" cy="250" rx="165" ry="90" transform="rotate(-35 300 250)" />
        <ellipse cx="300" cy="250" rx="90" ry="165" transform="rotate(-35 300 250)" opacity=".45" />
        <circle cx="300" cy="250" r="45" fill="currentColor" stroke="none" opacity=".8" />
      </g>}
      {preset === 'network' && <g stroke="currentColor" stroke-width="3">
        <path d="M110 140 290 90 490 170 440 370 210 400 110 140 440 370 290 90 210 400 490 170 110 140" opacity=".4" />
        {[ [110,140], [290,90], [490,170], [440,370], [210,400] ].map(([cx,cy]) => <circle cx={cx} cy={cy} r="24" fill="currentColor" />)}
      </g>}
      {preset === 'landscape' && <g stroke="currentColor" stroke-width="3">
        {Array.from({length: 10}, (_, i) => <path d={`M40 ${300+i*10} Q170 ${70+i*12} 300 ${210+i*10} T560 ${240+i*10}`} opacity={.25+i*.07} />)}
        <circle cx="420" cy="115" r="40" fill="currentColor" opacity=".18" stroke="none" />
      </g>}
    </svg>
    <canvas></canvas>
  </div>
  <button type="button" hidden aria-pressed="false" class="scene-pause">Pause motion</button>
</hero-scene>

<script>
  import { HeroSceneElement } from '../scripts/hero-element';
  if (!customElements.get('hero-scene')) customElements.define('hero-scene', HeroSceneElement);
</script>

<style>
  hero-scene { display: block; position: relative; width: 100%; aspect-ratio: 6 / 5; min-width: 0; color: var(--color-accent, #1a1b1c); isolation: isolate; }
  .scene-art { position: absolute; inset: 0; pointer-events: none; border-radius: 50%; background: radial-gradient(ellipse, color-mix(in srgb, currentColor 10%, transparent), transparent 68%); }
  canvas, .scene-fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas { opacity: 0; }
  hero-scene[data-state="ready"] canvas { opacity: 1; }
  hero-scene[data-state="ready"] .scene-fallback { opacity: 0; }
  .scene-pause { position: absolute; bottom: 1rem; right: 1rem; border: 1px solid var(--border-default, #ccc); border-radius: 999px; padding: .55rem .85rem; font: inherit; font-size: .8rem; cursor: pointer; background: var(--bg-page, white); color: var(--text-primary, #1a1b1c); }
  .scene-pause[hidden] { display: none; }
  .scene-pause:focus-visible { outline: 3px solid var(--focus-outline, currentColor); outline-offset: 4px; }
</style>
